<Project Sdk="Microsoft.NET.Sdk">

  <!-- Kestrel rather than HttpListener: http.sys needs a URL ACL or elevation to listen on
       anything but localhost, and a portable exe can arrange neither. Plain net10.0 so the
       Linux job builds and tests it alongside the other portable libraries. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.4.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The page ships inside the assembly, so the single-file exe has nothing beside it to
       lose and a dashboard on a LAN with filtered egress still gets its map library. -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
