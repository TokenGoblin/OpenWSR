<Window x:Class="OpenWSR.App.ForecastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forecast" Width="720" Height="800"
        MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Chrome}" Foreground="{StaticResource Text}">
    <DockPanel>
        <!-- ============ Header: the place, and where the observation comes from ============ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Rail}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="PlaceText" FontSize="19" FontWeight="SemiBold"
                               VerticalAlignment="Center" Text="Forecast" />
                    <TextBlock x:Name="OfficeText" FontSize="12" Margin="10,0,0,0"
                               VerticalAlignment="Bottom" Padding="0,0,0,3"
                               Foreground="{StaticResource TextDim}" />
                </StackPanel>

                <!-- "Which station" is its own question and gets its own control, the same
                     rule the radar-station combo in the main window follows. The nearest
                     station that is actually reporting is chosen for you; this is how you
                     overrule it, and the distance beside each one is why you would. -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Observed at" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource TextDim}" />
                    <ComboBox x:Name="StationCombo" Width="330" Margin="8,0,0,0"
                              AutomationProperties.Name="Weather station reporting current conditions"
                              SelectionChanged="StationCombo_SelectionChanged"
                              ToolTip="Which surface station the current conditions come from. Nearest first — the one chosen for you is the closest that is still reporting." />
                    <TextBlock x:Name="ObservedAgeText" Margin="10,0,0,0" FontSize="12"
                               VerticalAlignment="Center" Foreground="{StaticResource TextDim}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============ Footer ============ -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Rail}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <TextBlock x:Name="SourceText" VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource TextDim}"
                           Text="National Weather Service · api.weather.gov" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RefreshButton" Content="Refresh" Width="88" Click="RefreshButton_Click"
                            AutomationProperties.Name="Fetch the forecast again" />
                    <Button Content="Close" Width="88" Margin="8,0,0,0" IsCancel="True"
                            Click="CloseButton_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Status: loading, or a failure that stays put ============ -->
        <Border x:Name="StatusBar" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1" Padding="16,9">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{StaticResource Text}" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14,16,14">
            <StackPanel>
                <!-- ============ Current conditions ============ -->
                <Border x:Name="CurrentCard" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="6" Padding="18,16" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CurrentGlyph" FontSize="46" VerticalAlignment="Center"
                                       Foreground="{StaticResource Text}" />
                            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="CurrentTemp" FontSize="40" FontWeight="Light"
                                           Foreground="{StaticResource Text}" />
                                <TextBlock x:Name="CurrentDescription" FontSize="14" Margin="0,2,0,0"
                                           Foreground="{StaticResource TextDim}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- A missing reading is drawn as an em dash rather than left out:
                             a row that disappears reads as a value of zero to anybody
                             scanning the block a second time. -->
                        <UniformGrid x:Name="CurrentStats" Columns="3" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="DaysHeading" Text="The next few days" Margin="2,20,0,8"
                           FontSize="13" FontWeight="SemiBold" Visibility="Collapsed"
                           Foreground="{StaticResource TextDim}" />
                <StackPanel x:Name="DaysPanel" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
