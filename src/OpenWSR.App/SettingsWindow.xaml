<Window x:Class="OpenWSR.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenWSR Settings" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1A1C21" Foreground="#C8CCD4">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8CCD4" />
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B93A3" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B93A3" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <!-- SizeToContent="Height" grows this window to whatever the content needs, and the
         content outgrew the screen: 1222 px of it at 125 % scaling on a 1200 px display, so
         the window hung 41 px off the top and put Save and Cancel under the taskbar — with
         ResizeMode="NoResize" leaving no way to recover. The content scrolls now, capped by
         MaxHeight in the constructor because the usable height is a fact about the screen
         rather than a layout constant. The buttons are docked outside the scroller: a dialog
         whose Save button can scroll out of reach is worse than one that is merely too tall. -->
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="88" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Save" Width="88" IsDefault="True" Click="Save_Click" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
        <TextBlock Text="MAP" Style="{StaticResource Head}" Margin="0,0,0,6" />
        <TextBlock Text="Basemap tiles" />
        <ComboBox x:Name="ProviderCombo" Margin="0,4,0,0" SelectionChanged="ProviderCombo_SelectionChanged">
            <ComboBoxItem Content="Dark — OpenStreetMap, darkened (no key needed)" />
            <ComboBoxItem Content="OpenStreetMap, as published (no key needed)" />
            <ComboBoxItem Content="MapTiler (needs a free key)" />
            <ComboBoxItem Content="Terrain — USGS topographic (no key needed)" />
        </ComboBox>
        <TextBlock x:Name="KeyLabel" Text="MapTiler key" Margin="0,10,0,0" />
        <TextBox x:Name="KeyBox" Margin="0,4,0,0" Background="#22252B" Foreground="#C8CCD4"
                 BorderBrush="#3A3F4A" Padding="4,3" />
        <TextBlock Style="{StaticResource Hint}"
                   Text="Dark is the default: reflectivity is a bright, saturated palette, and on a light street map it competes with the landcover and roads for the same part of the eye. The dark style is those same OpenStreetMap tiles inverted as they load, so minor roads drop out and place names sit under the weather rather than over it. Terrain is USGS topographic sheets: useful for reading a storm against the ground it is over, but busier than the dark style, so the weather stands out less. Get a free MapTiler key at maptiler.com — no card required. Changing the provider takes effect next launch." />

        <TextBlock Text="UNITS" Style="{StaticResource Head}" />
        <ComboBox x:Name="UnitsCombo">
            <ComboBoxItem Content="Miles, mph, feet" />
            <ComboBoxItem Content="Kilometres, km/h, metres" />
            <ComboBoxItem Content="Nautical miles, knots, feet" />
        </ComboBox>
        <TextBlock Style="{StaticResource Hint}"
                   Text="Applies to the inspector readout, the measuring tool, storm details and alerts." />

        <!-- The one place this app reads anything that is not public and unauthenticated, and
             it is off unless somebody opts in. It sits here rather than on the forecast page
             for the same reason home does: a key is pasted once and never touched again. -->
        <TextBlock Text="PERSONAL WEATHER STATIONS" Style="{StaticResource Head}" />
        <TextBlock Text="Weather Underground key (optional)" />
        <TextBox x:Name="PwsKeyBox" Margin="0,4,0,0" Background="#22252B" Foreground="#C8CCD4"
                 BorderBrush="#3A3F4A" Padding="4,3"
                 AutomationProperties.Name="Weather Underground API key"
                 ToolTip="Optional. With a key, the forecast page can read personal weather stations, which are usually far closer than the nearest NWS one." />
        <TextBlock Style="{StaticResource Hint}"
                   Text="Current conditions normally come from the nearest reporting National Weather Service station, which can be twenty miles away. A key lets the forecast page read personal weather stations instead — usually one within a mile or two. There is no keyless way to do this: every alternative was tested and none works. Weather Underground only issues free keys to people running a station of their own and uploading to it; if that is you, yours is at wunderground.com/member/api-keys. Note that these keys expire and have to be regenerated there — the forecast page will say so if it stops being accepted. The key is sent to api.weather.com and nowhere else, everything works without one, and clearing this box goes straight back to NWS stations. A personal station is somebody's garden — closer, but with no calibration behind it — so the forecast page always says which kind it is reading." />

        <!-- Your own station is a different question from the one above, and gets its own
             section rather than a third box under it: Weather Underground finds stations near
             a point, Ambient reads the station you own. Ambient has no way to look up anyone
             else's, so these two are not alternatives — someone may well want both. -->
        <TextBlock Text="MY WEATHER STATION" Style="{StaticResource Head}" />
        <TextBlock Text="Ambient Weather API key (optional)" />
        <TextBox x:Name="AmbientApiKeyBox" Margin="0,4,0,0" Background="#22252B" Foreground="#C8CCD4"
                 BorderBrush="#3A3F4A" Padding="4,3"
                 AutomationProperties.Name="Ambient Weather API key"
                 ToolTip="Grants access to the devices on your Ambient Weather account." />
        <TextBlock Text="Ambient Weather application key" Margin="0,8,0,0" />
        <TextBox x:Name="AmbientAppKeyBox" Margin="0,4,0,0" Background="#22252B" Foreground="#C8CCD4"
                 BorderBrush="#3A3F4A" Padding="4,3"
                 AutomationProperties.Name="Ambient Weather application key"
                 ToolTip="Identifies the program to Ambient Weather. Created on the same page as the API key." />
        <TextBlock Style="{StaticResource Hint}"
                   Text="If you own an Ambient Weather station, this reads it directly — the closest reading there is, because it is your garden rather than an airport. Create both keys at ambientweather.net/account: the API key grants access to your devices, the application key identifies the program asking, and you need both. They are sent to ambientweather.net and nowhere else. Your own station is preferred over every other source when it is reporting, and the forecast page says so; it is also the only source that can tell you whether it is raining on your own roof." />

        <TextBlock Text="ARCHIVE LOOP" Style="{StaticResource Head}" />
        <ComboBox x:Name="LoopFramesCombo" AutomationProperties.Name="Loop length">
            <ComboBoxItem Content="12 volumes — about 1 hour" Tag="12" />
            <ComboBoxItem Content="30 volumes — about 2½ hours" Tag="30" IsSelected="True" />
            <ComboBoxItem Content="60 volumes — about 5 hours" Tag="60" />
            <ComboBoxItem Content="144 volumes — about 12 hours" Tag="144" />
        </ComboBox>
        <TextBlock Style="{StaticResource Hint}"
                   Text="Every frame is downloaded, decoded and held in memory — roughly 5 MB each for reflectivity. A longer loop takes proportionally longer to build and takes effect the next time one is built." />

        <!-- Home and alert radius live here rather than in the layers panel: they are set
             once and never touched again, and the layers panel is used every session. -->
        <TextBlock Text="MY PLACES" Style="{StaticResource Head}" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                   Text="Every place here is watched for approaching storms. The primary — the filled dot — is the one the app opens on and follows storms from." />

        <ItemsControl x:Name="PlaceList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#22252B" BorderBrush="#3A3F4A" BorderThickness="1"
                            CornerRadius="3" Padding="7,5" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <RadioButton GroupName="PrimaryPlace" VerticalAlignment="Center"
                                         Margin="0,0,8,0" IsChecked="{Binding IsPrimary}"
                                         Tag="{Binding}" Checked="Primary_Checked"
                                         ToolTip="Open the app here, and follow storms from this radar" />

                            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     AutomationProperties.Name="Place name"
                                     ToolTip="What to call this place" />

                            <ComboBox Grid.Column="2" Width="104" Margin="6,0,0,0"
                                      SelectedIndex="{Binding RadiusIndex, Mode=TwoWay}"
                                      AutomationProperties.Name="Alert radius for this place"
                                      ToolTip="Alert radius for this place">
                                <ComboBoxItem Content="Default" />
                                <ComboBoxItem Content="15 km / 9 mi" />
                                <ComboBoxItem Content="40 km / 25 mi" />
                                <ComboBoxItem Content="80 km / 50 mi" />
                                <ComboBoxItem Content="160 km / 100 mi" />
                            </ComboBox>

                            <Button Grid.Column="3" Content="✕" Width="22" Padding="0" FontSize="11"
                                    Margin="6,0,0,0" Background="Transparent" BorderThickness="0"
                                    Tag="{Binding}" Click="RemovePlace_Click"
                                    AutomationProperties.Name="Remove this place"
                                    ToolTip="Remove this place" />

                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                       Text="{Binding Where}" FontSize="10.5" FontFamily="Consolas"
                                       Foreground="#8B93A3" Margin="0,2,0,0" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="NoPlacesLabel" Style="{StaticResource Hint}" FontStyle="Normal"
                   Text="No places yet — add one below to arm proximity alerts." />

        <Grid Margin="0,6,0,0" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="LocateHomeButton" Content="Add my location" Click="LocateHome_Click"
                    ToolTip="Ask Windows Location Services where this PC is, and add it" />
            <Button x:Name="PickHomeButton" Grid.Column="1" Content="Move primary on map" Click="PickHome_Click"
                    Margin="6,0,0,0"
                    ToolTip="Close settings and click the map to move the primary place" />
        </Grid>
        <TextBlock x:Name="LocateStatus" Style="{StaticResource Hint}" Visibility="Collapsed" />

        <TextBlock Text="Default alert radius" Margin="0,10,0,0" />
        <ComboBox x:Name="RadiusCombo" Margin="0,4,0,0">
            <ComboBoxItem Content="15 km / 9 mi" />
            <ComboBoxItem Content="40 km / 25 mi" IsSelected="True" />
            <ComboBoxItem Content="80 km / 50 mi" />
            <ComboBoxItem Content="160 km / 100 mi" />
        </ComboBox>
        <TextBlock Style="{StaticResource Hint}"
                   Text="Used by any place set to Default." />

        <TextBlock Text="Interrupt me when a storm will pass within" Margin="0,10,0,0" />
        <ComboBox x:Name="DirectHitCombo" Margin="0,4,0,0" AutomationProperties.Name="Direct hit radius">
            <ComboBoxItem Content="2 km / 1 mi — practically overhead" />
            <ComboBoxItem Content="8 km / 5 mi" IsSelected="True" />
            <ComboBoxItem Content="16 km / 10 mi" />
            <ComboBoxItem Content="Anything inside the alert radius" />
        </ComboBox>
        <TextBlock Style="{StaticResource Hint}"
                   Text="A storm that comes inside a place's alert radius but misses by more than this still appears in the APPROACHING list, saying which side it passes — it just does not raise a notification. A storm already moving away raises nothing at all. Warnings and rotating cells always interrupt, whichever way they are going." />

        <!-- Alerting is only worth anything while the process is running, so how OpenWSR
             stays running belongs directly under the two radii that decide what it alerts
             about. Set-once configuration, which is why it is here and not in the layers
             panel. -->
        <TextBlock Text="RUNNING IN THE BACKGROUND" Style="{StaticResource Head}" />
        <CheckBox x:Name="CloseToTrayCheck" Content="Closing the window keeps watching, in the tray"
                  Margin="0,2,0,0" />
        <CheckBox x:Name="MinimiseToTrayCheck" Content="Minimising hides it to the tray as well"
                  Margin="0,6,0,0" />
        <CheckBox x:Name="StartInTrayCheck" Content="Start in the tray, without opening the window"
                  Margin="0,6,0,0" />
        <CheckBox x:Name="StartWithWindowsCheck" Content="Start OpenWSR when I sign in to Windows"
                  Margin="0,6,0,0" />
        <TextBlock Style="{StaticResource Hint}"
                   Text="In the tray OpenWSR keeps checking storm tracks every two minutes and warnings every minute, and notifies you the same way it would with the window open. Everything else stops while it is hidden — the live radar stream, the satellite, the mosaics, lightning — because those draw the map rather than watch for storms, and they start again when you open the window. Right-click the tray icon to open it or to exit." />

        <!-- Directly under the tray settings because it is the same idea taken one step on:
             what OpenWSR is watching, visible from somewhere other than this PC. -->
        <TextBlock Text="DASHBOARD ON YOUR NETWORK" Style="{StaticResource Head}" />
        <CheckBox x:Name="DashboardCheck" Content="Serve a radar and alerts page to other devices"
                  Margin="0,2,0,0" Checked="Dashboard_Toggled" Unchecked="Dashboard_Toggled" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Port" VerticalAlignment="Center" />
            <TextBox x:Name="DashboardPortBox" Width="70" Margin="8,0,0,0" Background="#22252B"
                     Foreground="#C8CCD4" BorderBrush="#3A3F4A" Padding="4,3"
                     AutomationProperties.Name="Dashboard port" />
        </StackPanel>
        <TextBlock x:Name="DashboardPortError" Style="{StaticResource Hint}" FontStyle="Normal"
                   Foreground="#FF8A80" Visibility="Collapsed" />
        <ItemsControl x:Name="DashboardUrls" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                                 Background="#22252B" Foreground="#C8CCD4" BorderBrush="#3A3F4A"
                                 Padding="4,3" AutomationProperties.Name="Dashboard address" />
                        <Button Grid.Column="1" Content="Copy" Margin="6,0,0,0" Tag="{Binding}"
                                Click="CopyDashboardUrl_Click" ToolTip="Copy this address" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Style="{StaticResource Hint}"
                   Text="Open one of these addresses on a phone, a tablet, or in a Home Assistant webpage card to see the radar, warnings, storm cells and the APPROACHING list — and it keeps working while OpenWSR is in the tray. Add ?view=map, ?view=threats or ?view=storms to show one part, and &amp;theme=light for a light page. Anyone on your network can open it, with no password, and it shows your saved places and their alert rings — so leave it off on a network you share with people you don't know. Windows may ask whether to allow OpenWSR through the firewall the first time; allow it on private networks. If Home Assistant is opened over https, the browser refuses an http page inside it: open Home Assistant over http on your network, or serve both through the same proxy." />

        <TextBlock Text="COLOUR TABLES" Style="{StaticResource Head}" />
        <Button x:Name="PaletteButton" Content="Import a .pal file…" Click="Palette_Click"
                HorizontalAlignment="Left" />
        <TextBlock Style="{StaticResource Hint}"
                   Text="A GR2Analyst colour table, applied to whichever product is showing when you import it. Saving closes this window and opens the file picker." />

        <TextBlock Text="CONTACT FOR WEATHER.GOV" Style="{StaticResource Head}" />
        <TextBox x:Name="ContactBox" Margin="0,4,0,0" Background="#22252B" Foreground="#C8CCD4"
                 BorderBrush="#3A3F4A" Padding="4,3" />
        <TextBlock Style="{StaticResource Hint}"
                   Text="The National Weather Service API asks every client to identify itself with a contact address, and may block clients that don't. Your email or a website is fine — it is sent only to weather.gov, with no other data." />
        <TextBlock x:Name="UaPreview" Style="{StaticResource Hint}" FontStyle="Normal" FontFamily="Consolas" />

        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
