<Window x:Class="OpenWSR.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenWSR Settings" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1A1C21" Foreground="#C8CCD4">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8CCD4" />
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B93A3" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B93A3" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="MAP" Style="{StaticResource Head}" Margin="0,0,0,6" />
        <TextBlock Text="Basemap tiles" />
        <ComboBox x:Name="ProviderCombo" Margin="0,4,0,0" SelectionChanged="ProviderCombo_SelectionChanged">
            <ComboBoxItem Content="OpenStreetMap (no key needed)" />
            <ComboBoxItem Content="MapTiler (needs a free key)" />
        </ComboBox>
        <TextBlock x:Name="KeyLabel" Text="MapTiler key" Margin="0,10,0,0" />
        <TextBox x:Name="KeyBox" Margin="0,4,0,0" Background="#22252B" Foreground="#C8CCD4"
                 BorderBrush="#3A3F4A" Padding="4,3" />
        <TextBlock Style="{StaticResource Hint}"
                   Text="Get a free key at maptiler.com — no card required. Changing the provider takes effect next launch." />

        <TextBlock Text="UNITS" Style="{StaticResource Head}" />
        <ComboBox x:Name="UnitsCombo">
            <ComboBoxItem Content="Miles, mph, feet" />
            <ComboBoxItem Content="Kilometres, km/h, metres" />
            <ComboBoxItem Content="Nautical miles, knots, feet" />
        </ComboBox>
        <TextBlock Style="{StaticResource Hint}"
                   Text="Applies to the inspector readout, the measuring tool, storm details and alerts." />

        <TextBlock Text="ARCHIVE LOOP" Style="{StaticResource Head}" />
        <ComboBox x:Name="LoopFramesCombo" AutomationProperties.Name="Loop length">
            <ComboBoxItem Content="12 volumes — about 1 hour" Tag="12" />
            <ComboBoxItem Content="30 volumes — about 2½ hours" Tag="30" IsSelected="True" />
            <ComboBoxItem Content="60 volumes — about 5 hours" Tag="60" />
            <ComboBoxItem Content="144 volumes — about 12 hours" Tag="144" />
        </ComboBox>
        <TextBlock Style="{StaticResource Hint}"
                   Text="Every frame is downloaded, decoded and held in memory — roughly 5 MB each for reflectivity. A longer loop takes proportionally longer to build and takes effect the next time one is built." />

        <!-- Home and alert radius live here rather than in the layers panel: they are set
             once and never touched again, and the layers panel is used every session. -->
        <TextBlock Text="MY AREA" Style="{StaticResource Head}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HomeLabel" Text="Home: not set" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="PickHomeButton" Content="📍 Pick on map" Click="PickHome_Click"
                        ToolTip="Close settings and click the map to place your home location" />
                <Button x:Name="ClearHomeButton" Content="Clear" Margin="6,0,0,0" Click="ClearHome_Click" />
            </StackPanel>
        </Grid>
        <TextBlock Text="Alert radius" Margin="0,10,0,0" />
        <ComboBox x:Name="RadiusCombo" Margin="0,4,0,0">
            <ComboBoxItem Content="15 km / 9 mi" />
            <ComboBoxItem Content="40 km / 25 mi" IsSelected="True" />
            <ComboBoxItem Content="80 km / 50 mi" />
            <ComboBoxItem Content="160 km / 100 mi" />
        </ComboBox>
        <TextBlock Style="{StaticResource Hint}"
                   Text="With a home set, OpenWSR raises a tray notification when a tracked storm's forecast path or a warning polygon comes within this range — and arms the storm layer on the nearest radar." />

        <TextBlock Text="CONTACT FOR WEATHER.GOV" Style="{StaticResource Head}" />
        <TextBox x:Name="ContactBox" Margin="0,4,0,0" Background="#22252B" Foreground="#C8CCD4"
                 BorderBrush="#3A3F4A" Padding="4,3" />
        <TextBlock Style="{StaticResource Hint}"
                   Text="The National Weather Service API asks every client to identify itself with a contact address, and may block clients that don't. Your email or a website is fine — it is sent only to weather.gov, with no other data." />
        <TextBlock x:Name="UaPreview" Style="{StaticResource Hint}" FontStyle="Normal" FontFamily="Consolas" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" Width="88" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Save" Width="88" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
