<Window x:Class="OpenWSR.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenWSR Settings" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1A1C21" Foreground="#C8CCD4">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8CCD4" />
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B93A3" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8B93A3" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="MAP" Style="{StaticResource Head}" Margin="0,0,0,6" />
        <TextBlock Text="Basemap tiles" />
        <ComboBox x:Name="ProviderCombo" Margin="0,4,0,0" SelectionChanged="ProviderCombo_SelectionChanged">
            <ComboBoxItem Content="OpenStreetMap (no key needed)" />
            <ComboBoxItem Content="MapTiler (needs a free key)" />
        </ComboBox>
        <TextBlock x:Name="KeyLabel" Text="MapTiler key" Margin="0,10,0,0" />
        <TextBox x:Name="KeyBox" Margin="0,4,0,0" Background="#22252B" Foreground="#C8CCD4"
                 BorderBrush="#3A3F4A" Padding="4,3" />
        <TextBlock Style="{StaticResource Hint}"
                   Text="Get a free key at maptiler.com — no card required. Changing the provider takes effect next launch." />

        <TextBlock Text="UNITS" Style="{StaticResource Head}" />
        <ComboBox x:Name="UnitsCombo">
            <ComboBoxItem Content="Miles, mph, feet" />
            <ComboBoxItem Content="Kilometres, km/h, metres" />
            <ComboBoxItem Content="Nautical miles, knots, feet" />
        </ComboBox>
        <TextBlock Style="{StaticResource Hint}"
                   Text="Applies to the inspector readout, the measuring tool, storm details and alerts." />

        <TextBlock Text="ARCHIVE LOOP" Style="{StaticResource Head}" />
        <ComboBox x:Name="LoopFramesCombo" AutomationProperties.Name="Loop length">
            <ComboBoxItem Content="12 volumes — about 1 hour" Tag="12" />
            <ComboBoxItem Content="30 volumes — about 2½ hours" Tag="30" IsSelected="True" />
            <ComboBoxItem Content="60 volumes — about 5 hours" Tag="60" />
            <ComboBoxItem Content="144 volumes — about 12 hours" Tag="144" />
        </ComboBox>
        <TextBlock Style="{StaticResource Hint}"
                   Text="Every frame is downloaded, decoded and held in memory — roughly 5 MB each for reflectivity. A longer loop takes proportionally longer to build and takes effect the next time one is built." />

        <!-- Home and alert radius live here rather than in the layers panel: they are set
             once and never touched again, and the layers panel is used every session. -->
        <TextBlock Text="MY PLACES" Style="{StaticResource Head}" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                   Text="Every place here is watched for approaching storms. The primary — the filled dot — is the one the app opens on and follows storms from." />

        <ItemsControl x:Name="PlaceList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#22252B" BorderBrush="#3A3F4A" BorderThickness="1"
                            CornerRadius="3" Padding="7,5" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <RadioButton GroupName="PrimaryPlace" VerticalAlignment="Center"
                                         Margin="0,0,8,0" IsChecked="{Binding IsPrimary}"
                                         Tag="{Binding}" Checked="Primary_Checked"
                                         ToolTip="Open the app here, and follow storms from this radar" />

                            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     AutomationProperties.Name="Place name"
                                     ToolTip="What to call this place" />

                            <ComboBox Grid.Column="2" Width="104" Margin="6,0,0,0"
                                      SelectedIndex="{Binding RadiusIndex, Mode=TwoWay}"
                                      AutomationProperties.Name="Alert radius for this place"
                                      ToolTip="Alert radius for this place">
                                <ComboBoxItem Content="Default" />
                                <ComboBoxItem Content="15 km / 9 mi" />
                                <ComboBoxItem Content="40 km / 25 mi" />
                                <ComboBoxItem Content="80 km / 50 mi" />
                                <ComboBoxItem Content="160 km / 100 mi" />
                            </ComboBox>

                            <Button Grid.Column="3" Content="✕" Width="22" Padding="0" FontSize="11"
                                    Margin="6,0,0,0" Background="Transparent" BorderThickness="0"
                                    Tag="{Binding}" Click="RemovePlace_Click"
                                    AutomationProperties.Name="Remove this place"
                                    ToolTip="Remove this place" />

                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                       Text="{Binding Where}" FontSize="10.5" FontFamily="Consolas"
                                       Foreground="#8B93A3" Margin="0,2,0,0" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="NoPlacesLabel" Style="{StaticResource Hint}" FontStyle="Normal"
                   Text="No places yet — add one below to arm proximity alerts." />

        <Grid Margin="0,6,0,0" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="LocateHomeButton" Content="Add my location" Click="LocateHome_Click"
                    ToolTip="Ask Windows Location Services where this PC is, and add it" />
            <Button x:Name="PickHomeButton" Grid.Column="1" Content="Move primary on map" Click="PickHome_Click"
                    Margin="6,0,0,0"
                    ToolTip="Close settings and click the map to move the primary place" />
        </Grid>
        <TextBlock x:Name="LocateStatus" Style="{StaticResource Hint}" Visibility="Collapsed" />

        <TextBlock Text="Default alert radius" Margin="0,10,0,0" />
        <ComboBox x:Name="RadiusCombo" Margin="0,4,0,0">
            <ComboBoxItem Content="15 km / 9 mi" />
            <ComboBoxItem Content="40 km / 25 mi" IsSelected="True" />
            <ComboBoxItem Content="80 km / 50 mi" />
            <ComboBoxItem Content="160 km / 100 mi" />
        </ComboBox>
        <TextBlock Style="{StaticResource Hint}"
                   Text="Used by any place set to Default." />

        <TextBlock Text="Interrupt me when a storm will pass within" Margin="0,10,0,0" />
        <ComboBox x:Name="DirectHitCombo" Margin="0,4,0,0" AutomationProperties.Name="Direct hit radius">
            <ComboBoxItem Content="2 km / 1 mi — practically overhead" />
            <ComboBoxItem Content="8 km / 5 mi" IsSelected="True" />
            <ComboBoxItem Content="16 km / 10 mi" />
            <ComboBoxItem Content="Anything inside the alert radius" />
        </ComboBox>
        <TextBlock Style="{StaticResource Hint}"
                   Text="A storm that comes inside a place's alert radius but misses by more than this still appears in the APPROACHING list, saying which side it passes — it just does not raise a notification. A storm already moving away raises nothing at all. Warnings and rotating cells always interrupt, whichever way they are going." />

        <TextBlock Text="COLOUR TABLES" Style="{StaticResource Head}" />
        <Button x:Name="PaletteButton" Content="Import a .pal file…" Click="Palette_Click"
                HorizontalAlignment="Left" />
        <TextBlock Style="{StaticResource Hint}"
                   Text="A GR2Analyst colour table, applied to whichever product is showing when you import it. Saving closes this window and opens the file picker." />

        <TextBlock Text="CONTACT FOR WEATHER.GOV" Style="{StaticResource Head}" />
        <TextBox x:Name="ContactBox" Margin="0,4,0,0" Background="#22252B" Foreground="#C8CCD4"
                 BorderBrush="#3A3F4A" Padding="4,3" />
        <TextBlock Style="{StaticResource Hint}"
                   Text="The National Weather Service API asks every client to identify itself with a contact address, and may block clients that don't. Your email or a website is fine — it is sent only to weather.gov, with no other data." />
        <TextBlock x:Name="UaPreview" Style="{StaticResource Hint}" FontStyle="Normal" FontFamily="Consolas" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" Width="88" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Save" Width="88" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
