<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OpenWSR.Render\OpenWSR.Render.csproj" />
    <ProjectReference Include="..\OpenWSR.Ingest\OpenWSR.Ingest.csproj" />
    <ProjectReference Include="..\OpenWSR.NetCdf\OpenWSR.NetCdf.csproj" />
    <ProjectReference Include="..\OpenWSR.Nexrad\OpenWSR.Nexrad.csproj" />
    <ProjectReference Include="..\OpenWSR.Geo\OpenWSR.Geo.csproj" />
    <ProjectReference Include="..\OpenWSR.Palettes\OpenWSR.Palettes.csproj" />
    <ProjectReference Include="..\OpenWSR.Placefiles\OpenWSR.Placefiles.csproj" />
  </ItemGroup>

  <!-- Keep WinForms off the global using list: it collides with WPF on Application,
       Color, Brushes, MessageBox and Size. TrayNotifier imports it explicitly. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms is here only for NotifyIcon: tray balloons need no app packaging. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WFO0003 tells WinForms apps to drop DPI settings from the manifest; this is a
         WPF app whose manifest is correct, so the advice does not apply. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>OpenWSR</AssemblyName>
    <ApplicationIcon>..\..\assets\brand\openwsr.ico</ApplicationIcon>
    <Product>OpenWSR</Product>
    <Company>OpenWSR</Company>
    <Authors>TokenGoblin</Authors>
    <Copyright>Copyright (c) 2026 TokenGoblin</Copyright>
    <Description>Native Windows NEXRAD radar viewer</Description>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- dotnet publish -c Release -r win-x64 produces a single self-contained exe -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

</Project>
