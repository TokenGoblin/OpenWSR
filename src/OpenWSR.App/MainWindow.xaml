<Window x:Class="OpenWSR.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenWSR" Width="1360" Height="860" Background="{StaticResource Chrome}">
    <DockPanel>
        <!-- Left navigation rail: app and view actions, Windows 11 style with
             settings anchored at the bottom. -->
        <Border DockPanel.Dock="Left" Width="50" Background="{StaticResource Rail}"
                BorderBrush="#FF272C35" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,6,0,0">
                    <ToggleButton x:Name="LayersToggle" Style="{StaticResource RailToggle}" IsChecked="True"
                                  Content="▤" Checked="LayersToggle_Changed" Unchecked="LayersToggle_Changed"
                                  ToolTip="Show or hide the layers panel" />
                    <Button x:Name="HotspotButton" Style="{StaticResource RailButton}" Content="🎯"
                            Click="HotspotButton_Click"
                            ToolTip="Go to the heaviest precipitation in the USA right now" />
                    <Button x:Name="PaneButton" Style="{StaticResource RailButton}" Content="◱"
                            Click="PaneButton_Click" ToolTip="Map panes: 1" />
                    <ToggleButton x:Name="LinkToggle" Style="{StaticResource RailToggle}" Content="⛓"
                                  IsChecked="True" Checked="LinkToggle_Changed" Unchecked="LinkToggle_Changed"
                                  ToolTip="Link pan and zoom across panes" />
                    <ToggleButton x:Name="CrossSectionToggle" Style="{StaticResource RailToggle}" Content="⌇"
                                  Checked="CrossSectionToggle_Changed" Unchecked="CrossSectionToggle_Changed"
                                  ToolTip="Cross-section mode — right-drag a line on the map to slice the storm vertically" />
                    <Button x:Name="CaptureButton" Style="{StaticResource RailButton}" Content="📷"
                            Click="CaptureButton_Click"
                            ToolTip="Save the map as a PNG, or the loaded loop as an animated GIF" />
                    <Button x:Name="PaletteButton" Style="{StaticResource RailButton}" Content="🎨"
                            Click="PaletteButton_Click"
                            ToolTip="Import a GR2Analyst .pal colour table for the current product" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,6">
                    <Border Height="1" Background="#FF272C35" Margin="10,4" />
                    <Button x:Name="SettingsButton" Style="{StaticResource RailButton}" Content="⚙"
                            Click="SettingsButton_Click" ToolTip="Settings" />
                    <Button x:Name="AboutButton" Style="{StaticResource RailButton}" Content="ⓘ"
                            Click="AboutButton_Click" ToolTip="About OpenWSR" />
                </StackPanel>
                <Grid />
            </DockPanel>
        </Border>

        <!-- Top bar: what data am I looking at. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Chrome}"
                BorderBrush="#FF272C35" BorderThickness="0,0,0,1" Padding="8,7">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SearchBox" Width="168" KeyDown="SearchBox_KeyDown"
                         Tag="Search"
                         ToolTip="Find a place: city, ZIP code, or lat,lon — then jump to the nearest radar" />
                <ComboBox x:Name="SiteCombo" Width="212" Margin="7,0,0,0" />
                <Button x:Name="NearestButton" Content="Nearest" Margin="7,0,0,0" Click="NearestButton_Click"
                        ToolTip="Select the WSR-88D closest to the map centre" />
                <Separator />
                <DatePicker x:Name="DayPicker" Width="128" VerticalContentAlignment="Center" />
                <Button x:Name="LoadDayButton" Content="Load day" Margin="7,0,0,0" Click="LoadDayButton_Click" />
                <Separator />
                <ToggleButton x:Name="LiveToggle" Content="⦿  Live"
                              Checked="LiveToggle_Checked" Unchecked="LiveToggle_Unchecked"
                              ToolTip="Stream real-time data for the selected site" />
                <ToggleButton x:Name="StormsToggle" Content="⛈  Storms" Margin="7,0,0,0"
                              Checked="StormsToggle_Checked" Unchecked="StormsToggle_Unchecked"
                              ToolTip="Overlay storm tracks, hail and mesocyclones" />
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Rail}"
                BorderBrush="#FF272C35" BorderThickness="0,1,0,0" Padding="10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="AgeText" Text="" FontWeight="SemiBold" FontSize="12"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="OpenWSR" Margin="14,0,0,0"
                           FontSize="12" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                <TextBlock x:Name="InspectorText" Grid.Column="2" Text="" FontFamily="Consolas" FontSize="12"
                           Margin="16,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBlock x:Name="FpsText" Text="" FontSize="11"
                               Foreground="{StaticResource TextDisabled}" VerticalAlignment="Center" />
                    <TextBlock x:Name="AttributionText" Text="© OpenStreetMap contributors" FontSize="11"
                               Margin="14,0,0,0" Foreground="{StaticResource TextDisabled}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Chrome}" BorderBrush="#FF272C35"
                BorderThickness="0,1,0,0" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PlayButton" Content="▶" Width="34" Height="26" Padding="0"
                        FontSize="13" Click="PlayButton_Click"
                        ToolTip="Loop the most recent 30 volumes of the loaded day" />
                <ComboBox x:Name="SpeedCombo" Grid.Column="1" Width="66" Height="26" Margin="6,0,10,0"
                          SelectionChanged="SpeedCombo_SelectionChanged" ToolTip="Loop speed">
                    <ComboBoxItem Content="2 fps" />
                    <ComboBoxItem Content="4 fps" IsSelected="True" />
                    <ComboBoxItem Content="8 fps" />
                </ComboBox>
                <Grid Grid.Column="2" x:Name="TimelineArea" SizeChanged="TimelineArea_SizeChanged">
                    <Canvas x:Name="TickCanvas" Height="13" VerticalAlignment="Top" IsHitTestVisible="False" />
                    <Slider x:Name="TimeSlider" Margin="0,13,0,0" VerticalAlignment="Top"
                            Minimum="0" Maximum="0" IsEnabled="False"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            ValueChanged="TimeSlider_ValueChanged" />
                </Grid>
                <TextBlock x:Name="TimeSliderLabel" Grid.Column="3" Margin="12,0,2,0" MinWidth="152"
                           Foreground="#C8CCD4" VerticalAlignment="Center" FontFamily="Consolas"
                           Text="—" />
            </Grid>
        </Border>
        <!-- Vertical cross-section. WPF, docked below the map, so airspace is not an issue. -->
        <Border x:Name="CrossSectionPanel" DockPanel.Dock="Bottom" Height="248" Visibility="Collapsed"
                Background="{StaticResource Rail}" BorderBrush="#FF272C35" BorderThickness="0,1,0,0">
            <Grid Margin="10,6,10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CrossSectionTitle" Grid.ColumnSpan="2" FontWeight="SemiBold" FontSize="12"
                           Text="Cross-section — right-drag a line on the map" Margin="0,0,0,5" />

                <!-- Height axis -->
                <Grid Grid.Row="1" Grid.Column="0">
                    <TextBlock Text="15 km" FontSize="10" Foreground="{StaticResource TextDim}"
                               VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-6,6,0" />
                    <TextBlock Text="7.5" FontSize="10" Foreground="{StaticResource TextDim}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" />
                    <TextBlock Text="0" FontSize="10" Foreground="{StaticResource TextDim}"
                               VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,6,-4" />
                </Grid>

                <Border Grid.Row="1" Grid.Column="1" BorderBrush="#FF313742" BorderThickness="1"
                        Background="#FF1B1F27">
                    <Image x:Name="CrossSectionView" Stretch="Fill"
                           RenderOptions.BitmapScalingMode="Linear" />
                </Border>

                <Grid Grid.Row="2" Grid.Column="1" Margin="0,3,0,0">
                    <TextBlock x:Name="CrossSectionStart" Text="" FontSize="10"
                               Foreground="{StaticResource TextDim}" HorizontalAlignment="Left" />
                    <TextBlock x:Name="CrossSectionEnd" Text="" FontSize="10"
                               Foreground="{StaticResource TextDim}" HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="LayersPanel" DockPanel.Dock="Right" Background="{StaticResource Chrome}" Width="238"
                BorderBrush="#FF272C35" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,10">
                    <TextBlock Text="LAYERS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextDim}"
                               Margin="0,0,0,6" />

                    <TextBlock Text="Radar opacity" Margin="0,4,0,0" />
                    <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="85"
                            ValueChanged="OpacitySlider_ValueChanged" />
                    <TextBlock Text="Smoothing" Margin="0,6,0,0"
                               ToolTip="Blend between radar cells: raw gates → soft consumer-style display" />
                    <Slider x:Name="SmoothSlider" Minimum="0" Maximum="100" Value="0"
                            ValueChanged="SmoothSlider_ValueChanged" />

                    <TextBlock Text="National" FontWeight="Bold" Margin="0,12,0,2" />
                    <CheckBox x:Name="FilterMosaic" Content="National mosaic"
                              ToolTip="Seamless national reflectivity from the Iowa State NEXRAD mosaic"
                              Checked="MosaicFilter_Changed" Unchecked="MosaicFilter_Changed" />
                    <Slider x:Name="MosaicOpacitySlider" Minimum="0" Maximum="100" Value="75"
                            ValueChanged="MosaicOpacity_Changed" />
                    <CheckBox x:Name="FilterSatellite" Content="Satellite (GOES IR)"
                              ToolTip="Infrared cloud tops from GOES-East, under the radar layers"
                              Checked="SatelliteFilter_Changed" Unchecked="SatelliteFilter_Changed" />
                    <CheckBox x:Name="FilterOutlooks" Content="SPC outlook"
                              ToolTip="Day 1 categorical convective outlook"
                              Checked="OutlookFilter_Changed" Unchecked="OutlookFilter_Changed" />
                    <CheckBox x:Name="FilterWatches" Content="Watch boxes"
                              ToolTip="Active SPC tornado and severe thunderstorm watches"
                              Checked="OutlookFilter_Changed" Unchecked="OutlookFilter_Changed" />
                    <CheckBox x:Name="FilterDiscussions" Content="Mesoscale discussions"
                              Checked="OutlookFilter_Changed" Unchecked="OutlookFilter_Changed" />
                    <CheckBox x:Name="FilterReports" Content="Storm reports (6 h)"
                              ToolTip="Local storm reports: what actually happened on the ground"
                              Checked="OutlookFilter_Changed" Unchecked="OutlookFilter_Changed" />

                    <TextBlock Text="Warnings" FontWeight="Bold" Margin="0,12,0,2" />
                    <CheckBox x:Name="FilterTornado" Content="Tornado" IsChecked="True" Foreground="#FF6B6B"
                              Checked="WarningFilter_Changed" Unchecked="WarningFilter_Changed" />
                    <CheckBox x:Name="FilterSevere" Content="Severe thunderstorm" IsChecked="True" Foreground="#FFE066"
                              Checked="WarningFilter_Changed" Unchecked="WarningFilter_Changed" />
                    <CheckBox x:Name="FilterFlood" Content="Flash flood" IsChecked="True" Foreground="#7BE07B"
                              Checked="WarningFilter_Changed" Unchecked="WarningFilter_Changed" />
                    <CheckBox x:Name="FilterOtherWarn" Content="Other warnings" IsChecked="True"
                              Checked="WarningFilter_Changed" Unchecked="WarningFilter_Changed" />

                    <TextBlock Text="Storm tracking" FontWeight="Bold" Margin="0,10,0,2" />
                    <CheckBox x:Name="FilterPastTrack" Content="Past track" IsChecked="True"
                              Checked="StormFilter_Changed" Unchecked="StormFilter_Changed" />
                    <CheckBox x:Name="FilterForecastTrack" Content="Forecast track" IsChecked="True"
                              Checked="StormFilter_Changed" Unchecked="StormFilter_Changed" />
                    <CheckBox x:Name="FilterCones" Content="Projection cones" IsChecked="True"
                              ToolTip="Direction + swept area over the next hour"
                              Checked="StormFilter_Changed" Unchecked="StormFilter_Changed" />
                    <CheckBox x:Name="FilterLabels" Content="Cell ID + max dBZ" IsChecked="True"
                              Checked="StormFilter_Changed" Unchecked="StormFilter_Changed" />
                    <CheckBox x:Name="FilterHail" Content="Hail markers" IsChecked="True"
                              Checked="StormFilter_Changed" Unchecked="StormFilter_Changed" />
                    <CheckBox x:Name="FilterMeso" Content="Mesocyclones" IsChecked="True" Foreground="#FFE066"
                              Checked="StormFilter_Changed" Unchecked="StormFilter_Changed" />
                    <CheckBox x:Name="FilterStormRelative" Content="Storm-relative velocity"
                              ToolTip="Subtract the tracked storm motion from velocity so rotation stands out"
                              Checked="StormRelative_Changed" Unchecked="StormRelative_Changed" />
                    <TextBlock Text="Min severe-hail prob." Margin="0,6,0,0" />
                    <Slider x:Name="PoshSlider" Minimum="0" Maximum="100" Value="0" TickFrequency="10"
                            IsSnapToTickEnabled="True" ValueChanged="StormFilter_SliderChanged" />
                    <Border Background="{StaticResource Rail}" BorderBrush="#FF313742" BorderThickness="1" CornerRadius="2"
                            Padding="8,6" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="WHAT THE SYMBOLS MEAN" FontSize="10" Foreground="{StaticResource TextDim}"
                                       FontWeight="Bold" Margin="0,0,0,5" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition />
                                    <RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <Path Grid.Row="0" Data="M 6,0 L 12,6 L 6,12 L 0,6 Z" Fill="#F0F0F0"
                                      VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Cell now" FontSize="11"
                                           VerticalAlignment="Center" />
                                <Line Grid.Row="1" X1="0" Y1="6" X2="18" Y2="6" Stroke="#F0F0F0"
                                      StrokeThickness="1.5" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Past track" FontSize="11"
                                           VerticalAlignment="Center" />
                                <Line Grid.Row="2" X1="0" Y1="6" X2="18" Y2="6" Stroke="#F0F0F0"
                                      StrokeThickness="1.5" StrokeDashArray="2 2" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Forecast + cone" FontSize="11"
                                           VerticalAlignment="Center" />
                                <Path Grid.Row="3" Data="M 6,0 L 12,11 L 0,11 Z" Stroke="#FF7828"
                                      StrokeThickness="1.5" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Hail (size = risk)" FontSize="11"
                                           VerticalAlignment="Center" />
                                <Ellipse Grid.Row="4" Width="12" Height="12" Stroke="#FFDC28" StrokeThickness="1.5"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Mesocyclone" FontSize="11"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock FontStyle="Italic" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" FontSize="11"
                                       Margin="0,5,0,0" Text="Click any cell for details." />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="FUTURE RADAR" FontWeight="Bold" FontSize="11"
                               Foreground="{StaticResource TextDim}" Margin="0,16,0,4" />
                    <Button x:Name="FutureLoadButton" Content="Load HRRR forecast"
                            Click="FutureLoad_Click"
                            ToolTip="Simulated reflectivity for the next 6 hours from the HRRR model" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="FuturePrevButton" Content="◀" Width="30" Padding="0"
                                IsEnabled="False" Click="FuturePrev_Click" />
                        <Button x:Name="FuturePlayButton" Grid.Column="1" Content="▶" Width="30" Padding="0"
                                Margin="4,0,0,0" IsEnabled="False" Click="FuturePlay_Click" />
                        <Button x:Name="FutureNextButton" Grid.Column="2" Content="▶|" Width="34" Padding="0"
                                Margin="4,0,0,0" IsEnabled="False" Click="FutureNext_Click" />
                        <Button x:Name="FutureClearButton" Grid.Column="3" Content="Clear"
                                Margin="4,0,0,0" IsEnabled="False" Click="FutureClear_Click" />
                    </Grid>
                    <TextBlock x:Name="FutureLabel" Text="Not loaded" FontSize="11"
                               Foreground="{StaticResource TextDim}" Margin="0,5,0,0" TextWrapping="Wrap" />

                    <TextBlock Text="MY AREA" FontWeight="Bold" Foreground="{StaticResource TextDim}" Margin="0,14,0,4" />
                    <Button x:Name="SetHomeButton" Content="📍 Set home on map" Click="SetHomeButton_Click" />
                    <TextBlock x:Name="HomeLabel" Text="Home: not set" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="Alert radius" Margin="0,6,0,0" />
                    <ComboBox x:Name="RadiusCombo" SelectionChanged="RadiusCombo_SelectionChanged">
                        <ComboBoxItem Content="15 km" />
                        <ComboBoxItem Content="40 km" IsSelected="True" />
                        <ComboBoxItem Content="80 km" />
                        <ComboBoxItem Content="160 km" />
                    </ComboBox>
                    <TextBlock x:Name="AlertArmedLabel" FontStyle="Italic" Foreground="{StaticResource TextDim}"
                               TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Set a home location to arm proximity alerts." />
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Grid x:Name="PaneGrid">
            <Border x:Name="MapHost" />
        </Grid>
    </DockPanel>
</Window>
