<Window x:Class="OpenWSR.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenWSR" Width="1280" Height="800" Background="#1A1C21">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom" Background="#22252B" Foreground="#C8CCD4">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="OpenWSR" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="FpsText" Text="" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="AttributionText" Text="© OpenStreetMap contributors" />
            </StatusBarItem>
        </StatusBar>
        <Border x:Name="MapHost" />
    </DockPanel>
</Window>
