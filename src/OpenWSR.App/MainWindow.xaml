<Window x:Class="OpenWSR.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenWSR" Width="1360" Height="860"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource Chrome}">
    <!-- The shell is arranged around the four questions this app answers, in the order it
         answers them: WHERE (top bar) → WHAT product (bar above the map) → WHEN (time bar)
         → WHAT'S ON TOP (right panel). Each question has exactly one place and no second. -->
    <DockPanel>
        <!-- ============ Left rail: app actions, then map tools ============ -->
        <Border DockPanel.Dock="Left" Width="50" Background="{StaticResource Rail}"
                BorderBrush="#FF272C35" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,6,0,0">
                    <ToggleButton x:Name="LayersToggle" AutomationProperties.Name="Show or hide the layers panel" Style="{StaticResource RailToggle}" IsChecked="True"
                                  Content="▤" Checked="LayersToggle_Changed" Unchecked="LayersToggle_Changed"
                                  ToolTip="Show or hide the layers panel" />
                    <ToggleButton x:Name="WindProfileToggle" AutomationProperties.Name="Wind profile"
                                  Style="{StaticResource RailToggle}" Content="⇡"
                                  Checked="WindProfile_Changed" Unchecked="WindProfile_Changed"
                                  ToolTip="VAD wind profile — horizontal wind against height, fitted from this volume's velocity" />
                    <ToggleButton x:Name="VolumeToggle" AutomationProperties.Name="3D volume view"
                                  Style="{StaticResource RailToggle}" Content="◲" FontSize="15"
                                  Checked="Volume_Changed" Unchecked="Volume_Changed"
                                  ToolTip="3D — ray-march the whole volume; drag to orbit, wheel to zoom" />
                    <Button x:Name="HotspotButton" AutomationProperties.Name="Go to the heaviest precipitation in the USA" Style="{StaticResource RailButton}" Content="🎯"
                            Click="HotspotButton_Click"
                            ToolTip="Go to the heaviest precipitation in the USA right now" />
                    <Button x:Name="PaneButton" AutomationProperties.Name="Map panes" Style="{StaticResource RailButton}" Content="◱"
                            Click="PaneButton_Click" ToolTip="Map panes: 1" />
                    <!-- Collapsed at one pane rather than merely disabled: it held a
                         permanent slot in a rail that does not have one to spare, for a
                         control that cannot do anything until a second pane exists. -->
                    <ToggleButton x:Name="LinkToggle" AutomationProperties.Name="Link pan and zoom across panes" Style="{StaticResource RailToggle}" Content="⛓"
                                  IsChecked="True" Visibility="Collapsed"
                                  Checked="LinkToggle_Changed" Unchecked="LinkToggle_Changed"
                                  ToolTip="Link pan and zoom across panes" />

                    <!-- Map tools are one armed mode at a time, so a right-drag always means
                         exactly one thing and the status bar can say which. -->
                    <Border Height="1" Background="#FF272C35" Margin="10,6" />
                    <ToggleButton x:Name="InspectTool" AutomationProperties.Name="Inspect tool" Style="{StaticResource RailToggle}" Content="⌖"
                                  IsChecked="True" Tag="Inspect" Checked="ToolButton_Checked" Unchecked="ToolButton_Unchecked"
                                  ToolTip="Inspect — hover to read values, right-drag to measure" />
                    <ToggleButton x:Name="MeasureTool" AutomationProperties.Name="Measure tool" Style="{StaticResource RailToggle}" Content="📐"
                                  Tag="Measure" Checked="ToolButton_Checked" Unchecked="ToolButton_Unchecked"
                                  ToolTip="Measure — right-drag for geodesic distance and bearing" />
                    <ToggleButton x:Name="CrossSectionTool" AutomationProperties.Name="Cross-section tool" Style="{StaticResource RailToggle}" Content="⌇"
                                  Tag="CrossSection" Checked="ToolButton_Checked" Unchecked="ToolButton_Unchecked"
                                  ToolTip="Cross-section — right-drag a line to slice the storm vertically" />
                    <ToggleButton x:Name="DrawTool" AutomationProperties.Name="Drawing tool" Style="{StaticResource RailToggle}" Content="✎"
                                  Tag="Draw" Checked="ToolButton_Checked" Unchecked="ToolButton_Unchecked"
                                  ToolTip="Draw — annotate the map with lines, areas, circles and labels" />

                    <Border Height="1" Background="#FF272C35" Margin="10,6" />
                    <Button x:Name="CaptureButton" AutomationProperties.Name="Save image or animated GIF" Style="{StaticResource RailButton}" Content="📷"
                            Click="CaptureButton_Click"
                            ToolTip="Save the map as a PNG, or the loop as an animated GIF" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,6">
                    <Border Height="1" Background="#FF272C35" Margin="10,4" />
                    <Button x:Name="SettingsButton" AutomationProperties.Name="Settings" Style="{StaticResource RailButton}" Content="⚙"
                            Click="SettingsButton_Click" ToolTip="Settings" />
                    <Button x:Name="HelpButton" AutomationProperties.Name="How this app works" Style="{StaticResource RailButton}" Content="?"
                            Click="HelpButton_Click" ToolTip="How this app works — including how the storm alarm decides what to interrupt you for  (F1)" />
                </StackPanel>
                <Grid />
            </DockPanel>
        </Border>

        <!-- ============ WHERE ============ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Chrome}"
                BorderBrush="#FF272C35" BorderThickness="0,0,0,1" Padding="8,7">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SearchBox" AutomationProperties.Name="Search for a place" Width="200" KeyDown="SearchBox_KeyDown"
                         Tag="Search"
                         ToolTip="Find a place: city, ZIP code, or lat,lon — then jump to the nearest radar" />
                <ComboBox x:Name="SiteCombo" AutomationProperties.Name="Radar site" Width="240" Margin="7,0,0,0"
                          SelectionChanged="SiteCombo_SelectionChanged"
                          ToolTip="The WSR-88D whose data is being shown" />
                <Button x:Name="NearestButton" Content="Nearest" Margin="7,0,0,0" Click="NearestButton_Click"
                        ToolTip="Select the WSR-88D closest to the map centre" />
            </StackPanel>
        </Border>

        <!-- Errors persist until dismissed. They used to share the status line with the
             sweep readout, which overwrote them within a second. -->
        <Border x:Name="ErrorBar" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="#FF3A2226" BorderBrush="#FF8E4048" BorderThickness="0,0,0,1" Padding="10,7">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Dismiss" Padding="9,3" FontSize="12"
                        Click="DismissError_Click" />
                <TextBlock x:Name="ErrorText" Foreground="#FFFFC8C8" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12.5" />
            </DockPanel>
        </Border>

        <!-- ============ Status ============ -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Rail}"
                BorderBrush="#FF272C35" BorderThickness="0,1,0,0" Padding="10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="AgeText" Text="" FontWeight="SemiBold" FontSize="12"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="OpenWSR" Margin="14,0,0,0"
                           FontSize="12" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="460" />
                <TextBlock x:Name="InspectorText" Grid.Column="2" Text="" FontFamily="Consolas" FontSize="12"
                           Margin="16,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBlock x:Name="FpsText" Text="" FontSize="11"
                               Foreground="{StaticResource TextDisabled}" VerticalAlignment="Center" />
                    <TextBlock x:Name="AttributionText" Text="© OpenStreetMap contributors" FontSize="11"
                               Margin="14,0,0,0" Foreground="{StaticResource TextDisabled}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ WHEN — one bar, one transport, three modes ============ -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Chrome}" BorderBrush="#FF272C35"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <ProgressBar x:Name="TaskProgress" DockPanel.Dock="Top" Height="2" Minimum="0" Maximum="1"
                             Visibility="Collapsed" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource Accent}" />
                <DockPanel Margin="10,6">
                    <Border DockPanel.Dock="Left" Style="{StaticResource SegmentTrack}"
                            Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="LiveModeButton" Content="LIVE" Tag="Live"
                                          Style="{StaticResource Segment}"
                                          Checked="ModeButton_Checked" Unchecked="ModeButton_Unchecked"
                                          ToolTip="Stream real-time data for the selected site" />
                            <ToggleButton x:Name="ArchiveModeButton" Content="ARCHIVE" Tag="Archive"
                                          IsChecked="True" Style="{StaticResource Segment}"
                                          Checked="ModeButton_Checked" Unchecked="ModeButton_Unchecked"
                                          ToolTip="Browse any UTC day back to 1991" />
                            <ToggleButton x:Name="ForecastModeButton" Content="FORECAST" Tag="Forecast"
                                          Style="{StaticResource Segment}"
                                          Checked="ModeButton_Checked" Unchecked="ModeButton_Unchecked"
                                          ToolTip="HRRR simulated reflectivity for the next six hours" />
                        </StackPanel>
                    </Border>

                    <Grid>
                        <!-- LIVE -->
                        <StackPanel x:Name="LiveTransport" Orientation="Horizontal" Visibility="Collapsed"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="LiveStateText" VerticalAlignment="Center" FontSize="12.5"
                                       Foreground="{StaticResource TextDim}"
                                       Text="Streaming — partial volumes appear as each tilt completes." />
                        </StackPanel>

                        <!-- ARCHIVE -->
                        <Grid x:Name="ArchiveTransport">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <DatePicker x:Name="DayPicker" Width="126" VerticalContentAlignment="Center"
                                        SelectedDateChanged="DayPicker_SelectedDateChanged" />
                            <Button x:Name="PlayButton" AutomationProperties.Name="Play or pause the loop" Grid.Column="1" Content="▶" Width="34" Height="26"
                                    Padding="0" FontSize="13" Margin="10,0,0,0" Click="PlayButton_Click"
                                    ToolTip="Loop the most recent volumes of the loaded day" />
                            <ComboBox x:Name="SpeedCombo" Grid.Column="2" Width="66" Height="26"
                                      Margin="6,0,10,0" SelectionChanged="SpeedCombo_SelectionChanged"
                                      ToolTip="Loop speed">
                                <ComboBoxItem Content="2 fps" />
                                <ComboBoxItem Content="4 fps" IsSelected="True" />
                                <ComboBoxItem Content="8 fps" />
                            </ComboBox>
                            <Grid Grid.Column="4" x:Name="TimelineArea" SizeChanged="TimelineArea_SizeChanged">
                                <Canvas x:Name="TickCanvas" Height="13" VerticalAlignment="Top"
                                        IsHitTestVisible="False" />
                                <Slider x:Name="TimeSlider" AutomationProperties.Name="Scrub through the day" Margin="0,13,0,0" VerticalAlignment="Top"
                                        Minimum="0" Maximum="0" IsEnabled="False"
                                        IsSnapToTickEnabled="True" TickFrequency="1"
                                        ValueChanged="TimeSlider_ValueChanged" />
                            </Grid>
                            <TextBlock x:Name="TimeSliderLabel" Grid.Column="5" Margin="12,0,2,0" MinWidth="152"
                                       Foreground="#C8CCD4" VerticalAlignment="Center" FontFamily="Consolas"
                                       Text="—" />
                        </Grid>

                        <!-- FORECAST -->
                        <StackPanel x:Name="ForecastTransport" Orientation="Horizontal" Visibility="Collapsed"
                                    VerticalAlignment="Center">
                            <Button x:Name="FutureLoadButton" Content="Load HRRR forecast" Click="FutureLoad_Click"
                                    ToolTip="Simulated reflectivity for the next 6 hours from the HRRR model" />
                            <Button x:Name="FuturePrevButton" AutomationProperties.Name="Previous forecast hour" Content="◀" Width="30" Height="26" Padding="0"
                                    Margin="10,0,0,0" IsEnabled="False" Click="FuturePrev_Click" />
                            <Button x:Name="FuturePlayButton" AutomationProperties.Name="Play or pause the forecast" Content="▶" Width="30" Height="26" Padding="0"
                                    Margin="4,0,0,0" IsEnabled="False" Click="FuturePlay_Click" />
                            <Button x:Name="FutureNextButton" AutomationProperties.Name="Next forecast hour" Content="▶|" Width="34" Height="26" Padding="0"
                                    Margin="4,0,0,0" IsEnabled="False" Click="FutureNext_Click" />
                            <Button x:Name="FutureClearButton" Content="Clear" Margin="4,0,0,0"
                                    IsEnabled="False" Click="FutureClear_Click" />
                            <TextBlock x:Name="FutureLabel" Text="Not loaded" FontSize="12.5" Margin="14,0,0,0"
                                       Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- Vertical cross-section. WPF, docked below the map, so airspace is not an issue. -->
        <Border x:Name="CrossSectionPanel" DockPanel.Dock="Bottom" Height="248" Visibility="Collapsed"
                Background="{StaticResource Rail}" BorderBrush="#FF272C35" BorderThickness="0,1,0,0">
            <Grid Margin="10,6,10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CrossSectionTitle" Grid.ColumnSpan="2" FontWeight="SemiBold" FontSize="12"
                           Text="Cross-section — right-drag a line on the map" Margin="0,0,0,5" />

                <Grid Grid.Row="1" Grid.Column="0">
                    <TextBlock Text="15 km" FontSize="10" Foreground="{StaticResource TextDim}"
                               VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-6,6,0" />
                    <TextBlock Text="7.5" FontSize="10" Foreground="{StaticResource TextDim}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" />
                    <TextBlock Text="0" FontSize="10" Foreground="{StaticResource TextDim}"
                               VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,6,-4" />
                </Grid>

                <Border Grid.Row="1" Grid.Column="1" BorderBrush="#FF313742" BorderThickness="1"
                        Background="#FF1B1F27">
                    <Image x:Name="CrossSectionView" Stretch="Fill"
                           RenderOptions.BitmapScalingMode="Linear" />
                </Border>

                <Grid Grid.Row="2" Grid.Column="1" Margin="0,3,0,0">
                    <TextBlock x:Name="CrossSectionStart" Text="" FontSize="10"
                               Foreground="{StaticResource TextDim}" HorizontalAlignment="Left" />
                    <TextBlock x:Name="CrossSectionEnd" Text="" FontSize="10"
                               Foreground="{StaticResource TextDim}" HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Border>

        <!-- ============ The right column ============ -->
        <!-- Two sections, and they answer different questions, so the layers toggle governs
             only the lower one. "What's on top" is a set-and-forget choice; "what is coming
             at me" is the thing the app exists to tell you, and tidying the layers away must
             not take a tornado warning off the screen with it. -->
        <Border x:Name="RightColumn" DockPanel.Dock="Right" Background="{StaticResource Chrome}" Width="248"
                BorderBrush="#FF272C35" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Collapsed whenever nothing is threatening, which is most of the time.
                     An empty "APPROACHING" heading is a claim that the app is watching; it
                     is only watching once a home location is set. -->
                <Border x:Name="ThreatPanel" Visibility="Collapsed" Background="#FF241A1A"
                        BorderBrush="#FF6B2A2A" BorderThickness="0,0,0,1" Padding="10,8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ThreatHeading" Text="APPROACHING" FontWeight="Bold"
                                       FontSize="11.5" Foreground="#FFFF9B7A" VerticalAlignment="Center" />
                            <TextBlock x:Name="ThreatCount" Grid.Column="1" FontSize="11"
                                       Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                        </Grid>
                        <ScrollViewer MaxHeight="252" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <ItemsControl x:Name="ThreatList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- A Border rather than a Button: the row is three
                                             stacked lines and every WPF button template wants
                                             to centre one line of content in the middle of it. -->
                                        <Border Background="#FF2E2020" BorderBrush="#FF5A3030"
                                                BorderThickness="1" CornerRadius="3"
                                                Padding="7,5" Margin="0,0,0,5" Cursor="Hand"
                                                Tag="{Binding}" MouseLeftButtonUp="ThreatRow_Click"
                                                ToolTip="{Binding Detail}">
                                            <!-- A glancing pass is real and belongs on the
                                                 list, but it is the answer "no" to the
                                                 question the notification asks, so it reads
                                                 quieter rather than identical. -->
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Interrupts}" Value="False">
                                                            <Setter Property="Background" Value="#FF24242B" />
                                                            <Setter Property="BorderBrush" Value="#FF3A3F4A" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap"
                                                           FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Text}" />
                                                <TextBlock Text="{Binding Range}" FontSize="11"
                                                           FontFamily="Consolas" Margin="0,2,0,0"
                                                           Foreground="#FFFFC46B" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Border BorderBrush="#FF5A3030" BorderThickness="0,1,0,0" Margin="0,2,0,0"
                                Padding="0,5,0,0">
                            <TextBlock FontSize="10" FontStyle="Italic" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextDim}"
                                       Text="Click one to put the camera on it." />
                        </Border>
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="LayersPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,8">

                    <Expander Header="RADAR" Style="{StaticResource PanelSection}">
                        <StackPanel>
                            <TextBlock Text="Opacity" Margin="0,2,0,0" FontSize="12" />
                            <Slider x:Name="OpacitySlider" AutomationProperties.Name="Radar opacity" Minimum="0" Maximum="100" Value="85"
                                    ValueChanged="OpacitySlider_ValueChanged" />
                            <TextBlock Text="Smoothing" Margin="0,6,0,0" FontSize="12"
                                       ToolTip="Blend between radar cells: raw gates → soft consumer-style display" />
                            <Slider x:Name="SmoothSlider" AutomationProperties.Name="Radar smoothing" Minimum="0" Maximum="100" Value="0"
                                    ValueChanged="SmoothSlider_ValueChanged" />
                            <CheckBox x:Name="FilterDealias" Content="Unfold velocity" Margin="0,8,0,0"
                                      ToolTip="Recover velocities past the Nyquist limit, where a strong couplet otherwise reads with its sign reversed"
                                      Checked="Dealias_Changed" Unchecked="Dealias_Changed" />
                            <TextBlock x:Name="DealiasNoteText" FontSize="10.5" FontStyle="Italic" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextDim}" Margin="18,2,0,0" Text="" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="LAYERS" Style="{StaticResource PanelSection}">
                        <StackPanel>
                            <CheckBox x:Name="FilterMosaic" Content="National mosaic"
                                      ToolTip="Seamless national reflectivity from the Iowa State NEXRAD mosaic"
                                      Checked="MosaicFilter_Changed" Unchecked="MosaicFilter_Changed" />
                            <Slider x:Name="MosaicOpacitySlider" AutomationProperties.Name="National mosaic opacity" Minimum="0" Maximum="100" Value="75"
                                    Margin="18,0,0,4" ValueChanged="MosaicOpacity_Changed" />

                            <CheckBox x:Name="FilterMrms" AutomationProperties.Name="MRMS composite"
                                      Content="MRMS composite (full res)"
                                      ToolTip="The same national field decoded from MRMS GRIB2 rather than pre-rendered tiles — stays sharp past zoom 12, where the tiles are stretched"
                                      Checked="Mrms_Changed" Unchecked="Mrms_Changed" />
                            <Slider x:Name="MrmsOpacitySlider" AutomationProperties.Name="MRMS opacity"
                                    Minimum="0" Maximum="100" Value="75" Margin="18,0,0,0"
                                    ValueChanged="MrmsOpacity_Changed" />
                            <TextBlock x:Name="MrmsNoteText" FontSize="10.5" FontStyle="Italic"
                                       TextWrapping="Wrap" Foreground="{StaticResource TextDim}"
                                       Margin="18,0,0,4" Text="" />

                            <CheckBox x:Name="FilterSatellite" AutomationProperties.Name="Satellite" Content="Satellite (GOES IR)"
                                      ToolTip="Infrared cloud tops from GOES-East ABI, decoded from the source every five minutes and drawn under the radar layers"
                                      Checked="SatelliteFilter_Changed" Unchecked="SatelliteFilter_Changed" />
                            <Slider x:Name="SatelliteOpacitySlider" AutomationProperties.Name="Satellite opacity" Minimum="0" Maximum="100" Value="60"
                                    Margin="18,0,0,0" ValueChanged="SatelliteOpacity_Changed" />
                            <TextBlock x:Name="SatelliteNoteText" FontSize="10.5" FontStyle="Italic"
                                       TextWrapping="Wrap" Foreground="{StaticResource TextDim}"
                                       Margin="18,0,0,4" Text="" />

                            <CheckBox x:Name="FilterLightning" AutomationProperties.Name="Lightning"
                                      Content="Lightning (GOES GLM)"
                                      ToolTip="Flashes from the Geostationary Lightning Mapper over the last 10 minutes, fading with age"
                                      Checked="Lightning_Changed" Unchecked="Lightning_Changed" />
                            <TextBlock x:Name="LightningNoteText" FontSize="10.5" FontStyle="Italic"
                                       TextWrapping="Wrap" Foreground="{StaticResource TextDim}"
                                       Margin="18,0,0,4" Text="" />

                            <Expander Header="ROTATION TRACKS" Style="{StaticResource PanelSection}" IsExpanded="False">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextDim}"
                                               Text="The strongest rotation seen at each point over the last hour of the loaded archive day — where a couplet has been, not just where it is now." />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="TracksBuildButton" Content="Build swath"
                                                AutomationProperties.Name="Build rotation tracks"
                                                Click="TracksBuild_Click" Margin="0,0,4,0" />
                                        <Button x:Name="TracksClearButton" Grid.Column="1" Content="Clear"
                                                AutomationProperties.Name="Clear rotation tracks"
                                                IsEnabled="False" Click="TracksClear_Click" />
                                    </Grid>
                                    <Slider x:Name="TracksOpacitySlider" AutomationProperties.Name="Rotation track opacity"
                                            Minimum="0" Maximum="100" Value="85" Margin="0,4,0,0"
                                            ValueChanged="TracksOpacity_Changed" />
                                    <TextBlock x:Name="TracksStatusText" FontSize="10.5" FontStyle="Italic"
                                               TextWrapping="Wrap" Foreground="{StaticResource TextDim}"
                                               Margin="0,2,0,0" Text="Archive mode only." />
                                </StackPanel>
                            </Expander>

                            <CheckBox x:Name="FilterSites" AutomationProperties.Name="Radar sites" Content="Radar sites" IsChecked="True"
                                      ToolTip="All 210 WSR-88D locations — hidden at national zoom, labelled up close"
                                      Checked="SiteMarkers_Changed" Unchecked="SiteMarkers_Changed" />

                            <Expander Header="Warnings" Style="{StaticResource PanelSection}" Margin="0,6,0,0">
                                <StackPanel>
                                    <CheckBox x:Name="FilterTornado" Content="Tornado" IsChecked="True" Foreground="#FF6B6B"
                                              Checked="WarningFilter_Changed" Unchecked="WarningFilter_Changed" />
                                    <CheckBox x:Name="FilterSevere" Content="Severe thunderstorm" IsChecked="True" Foreground="#FFE066"
                                              Checked="WarningFilter_Changed" Unchecked="WarningFilter_Changed" />
                                    <CheckBox x:Name="FilterFlood" Content="Flash flood" IsChecked="True" Foreground="#7BE07B"
                                              Checked="WarningFilter_Changed" Unchecked="WarningFilter_Changed" />
                                    <CheckBox x:Name="FilterOtherWarn" Content="Other warnings" IsChecked="True"
                                              Checked="WarningFilter_Changed" Unchecked="WarningFilter_Changed" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="STORMS" Style="{StaticResource PanelSection}">
                                <StackPanel>
                                    <CheckBox x:Name="StormsToggle" Content="Track storms" FontWeight="SemiBold"
                                              Checked="StormsToggle_Checked" Unchecked="StormsToggle_Unchecked"
                                              ToolTip="Fetch Level III storm tracks, hail and mesocyclones for this site" />
                                    <CheckBox x:Name="FilterPastTrack" Content="Past track" IsChecked="True" Margin="12,4,0,0"
                                              Checked="StormFilter_Changed" Unchecked="StormFilter_Changed" />
                                    <CheckBox x:Name="FilterForecastTrack" Content="Forecast track" IsChecked="True" Margin="12,0,0,0"
                                              Checked="StormFilter_Changed" Unchecked="StormFilter_Changed" />
                                    <CheckBox x:Name="FilterCones" Content="Projection cones" IsChecked="True" Margin="12,0,0,0"
                                              ToolTip="Direction + swept area over the next hour"
                                              Checked="StormFilter_Changed" Unchecked="StormFilter_Changed" />
                                    <CheckBox x:Name="FilterLabels" Content="Cell labels" IsChecked="True" Margin="12,0,0,0"
                                              ToolTip="Cell ID, plus max dBZ when the storm-structure product is available"
                                              Checked="StormFilter_Changed" Unchecked="StormFilter_Changed" />
                                    <CheckBox x:Name="FilterHail" Content="Hail markers" IsChecked="True" Margin="12,0,0,0"
                                              Checked="StormFilter_Changed" Unchecked="StormFilter_Changed" />
                                    <CheckBox x:Name="FilterMeso" Content="Mesocyclones" IsChecked="True" Foreground="#FFE066" Margin="12,0,0,0"
                                              Checked="StormFilter_Changed" Unchecked="StormFilter_Changed" />
                                    <CheckBox x:Name="FilterStormRelative" Content="Storm-relative velocity" Margin="12,0,0,0"
                                              ToolTip="Subtract the tracked storm motion from velocity so rotation stands out"
                                              Checked="StormRelative_Changed" Unchecked="StormRelative_Changed" />
                                    <TextBlock Text="Min severe-hail prob." Margin="12,6,0,0" FontSize="12" />
                                    <Slider x:Name="PoshSlider" AutomationProperties.Name="Minimum severe hail probability" Minimum="0" Maximum="100" Value="0" TickFrequency="10"
                                            Margin="12,0,0,0" IsSnapToTickEnabled="True"
                                            ValueChanged="StormFilter_SliderChanged" />
                                    <TextBlock x:Name="StormNoteText" FontSize="10.5" FontStyle="Italic" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextDim}" Margin="12,6,0,0" Text="" />
                                    <Button Content="What do the symbols mean?" Margin="12,6,0,0" FontSize="11"
                                            Padding="7,3" Click="SymbolKeyButton_Click" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="SPC &amp; REPORTS" Style="{StaticResource PanelSection}">
                                <StackPanel>
                                    <CheckBox x:Name="FilterOutlooks" Content="SPC outlook"
                                              ToolTip="Day 1 categorical convective outlook"
                                              Checked="OutlookFilter_Changed" Unchecked="OutlookFilter_Changed" />
                                    <CheckBox x:Name="FilterWatches" Content="Watch boxes"
                                              ToolTip="Active SPC tornado and severe thunderstorm watches"
                                              Checked="OutlookFilter_Changed" Unchecked="OutlookFilter_Changed" />
                                    <CheckBox x:Name="FilterDiscussions" Content="Mesoscale discussions"
                                              Checked="OutlookFilter_Changed" Unchecked="OutlookFilter_Changed" />
                                    <CheckBox x:Name="FilterReports" Content="Storm reports (6 h)"
                                              ToolTip="Local storm reports: what actually happened on the ground"
                                              Checked="OutlookFilter_Changed" Unchecked="OutlookFilter_Changed" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Expander>

                    <Expander Header="PLACEFILES" Style="{StaticResource PanelSection}" IsExpanded="False">
                        <StackPanel>
                            <ItemsControl x:Name="PlacefileList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding Enabled}"
                                                      ToolTip="{Binding Status}" Checked="PlacefileToggled"
                                                      Unchecked="PlacefileToggled" Tag="{Binding}" />
                                            <Button Grid.Column="1" Content="✕" Width="20" Padding="0" FontSize="10"
                                                    Background="Transparent" BorderThickness="0"
                                                    Click="PlacefileRemove_Click" Tag="{Binding}"
                                                    ToolTip="Remove this placefile" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Add URL…" Click="PlacefileAddUrl_Click" Margin="0,0,3,0" />
                                <Button Grid.Column="1" Content="Add file…" Click="PlacefileAddFile_Click" Margin="3,0,0,0" />
                            </Grid>
                            <TextBlock FontSize="10" FontStyle="Italic" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextDim}" Margin="0,4,0,0"
                                       Text="GRLevelX overlays. Each file refreshes on its own schedule and honours its own zoom thresholds." />
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>
            </Grid>
        </Border>

        <!-- ============ WHAT product, then the map ============ -->
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource Chrome}"
                    BorderBrush="#FF272C35" BorderThickness="0,0,0,1" Padding="8,6">
                <DockPanel>
                    <StackPanel x:Name="TiltPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Tilt" FontSize="12" Foreground="{StaticResource TextDim}"
                                   VerticalAlignment="Center" Margin="0,0,7,0" />
                        <ComboBox x:Name="TiltCombo" AutomationProperties.Name="Elevation cut" Width="92" Height="26" DisplayMemberPath="Label"
                                  SelectionChanged="TiltCombo_SelectionChanged"
                                  ToolTip="Elevation cut. ↑ and ↓ over the map step through them." />
                        <Button x:Name="TiltDownButton" AutomationProperties.Name="Lower tilt" Content="▼" Style="{StaticResource Stepper}"
                                Margin="6,0,0,0" Click="TiltDown_Click" ToolTip="Lower tilt  (↓)" />
                        <Button x:Name="TiltUpButton" AutomationProperties.Name="Higher tilt" Content="▲" Style="{StaticResource Stepper}"
                                Margin="3,0,0,0" Click="TiltUp_Click" ToolTip="Higher tilt  (↑)" />
                        <TextBlock x:Name="TiltCountText" FontSize="11.5" Foreground="{StaticResource TextDim}"
                                   VerticalAlignment="Center" Margin="9,0,2,0" MinWidth="76"
                                   FontFamily="Consolas" Text="" />
                    </StackPanel>

                    <Border Style="{StaticResource SegmentTrack}" HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <ItemsControl x:Name="MomentBar">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- The visible content is a code over a shortcut letter, which
                                         reads as nothing useful aloud; name it explicitly. -->
                                    <ToggleButton Style="{StaticResource MomentSegment}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsAvailable}"
                                                  ToolTip="{Binding Tooltip}"
                                                  AutomationProperties.Name="{Binding Description}"
                                                  Tag="{Binding}"
                                                  Checked="MomentSegment_Checked"
                                                  Unchecked="MomentSegment_Unchecked">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center"
                                                       FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Key}" HorizontalAlignment="Center"
                                                       FontSize="8.5" Opacity="0.6" Margin="0,-1,0,0" />
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Docked beside the map rather than floating over it: the D3D child window
                 always draws above WPF content inside its rectangle, so a panel over the
                 map would be invisible. -->
            <Border x:Name="VolumePanel" DockPanel.Dock="Right" Width="212"
                    Visibility="Collapsed" Background="{StaticResource Chrome}"
                    BorderBrush="#FF272C35" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,6,6,6">
                    <TextBlock Text="3D VOLUME" FontWeight="Bold" FontSize="11"
                               Foreground="{StaticResource TextDim}" Margin="0,0,0,6" />

                    <TextBlock x:Name="VolumeNote" FontSize="10.5" FontStyle="Italic"
                               TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{StaticResource TextDim}"
                               Text="Drag to orbit · wheel to zoom" />

                    <TextBlock x:Name="VolumeThresholdLabel" Text="Threshold" FontSize="10.5"
                               Foreground="{StaticResource TextDim}" />
                    <Slider x:Name="VolumeThresholdSlider" Minimum="-10" Maximum="60" Value="15"
                            TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,3,0,8"
                            AutomationProperties.Name="Display threshold"
                            ValueChanged="VolumeThreshold_Changed"
                            ToolTip="Anything weaker than this is not drawn at all" />

                    <TextBlock x:Name="VolumeDensityLabel" Text="Density" FontSize="10.5"
                               Foreground="{StaticResource TextDim}" />
                    <Slider x:Name="VolumeDensitySlider" Minimum="0.05" Maximum="0.9" Value="0.30"
                            Margin="0,3,0,8" AutomationProperties.Name="Density"
                            ValueChanged="VolumeDensity_Changed"
                            ToolTip="How solid the echo looks — low is an X-ray, high is a surface" />

                    <TextBlock x:Name="VolumeStretchLabel" Text="Vertical stretch" FontSize="10.5"
                               Foreground="{StaticResource TextDim}" />
                    <Slider x:Name="VolumeStretchSlider" Minimum="1" Maximum="15" Value="6"
                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,3,0,4"
                            AutomationProperties.Name="Vertical stretch"
                            ValueChanged="VolumeStretch_Changed" />
                    <TextBlock FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{StaticResource TextDim}"
                               Text="A storm 12 km tall in a 300 km box is a smear at true scale, so the vertical is stretched. The figure above is the factor." />

                    <TextBlock Text="Range" FontSize="10.5" Foreground="{StaticResource TextDim}" />
                    <ComboBox x:Name="VolumeRangeCombo" Margin="0,3,0,8"
                              AutomationProperties.Name="Box range"
                              SelectionChanged="VolumeRange_Changed">
                        <ComboBoxItem Content="60 km — one storm" Tag="60000" />
                        <ComboBoxItem Content="100 km — a cluster" Tag="100000" />
                        <ComboBoxItem Content="150 km — the whole scan" Tag="150000" IsSelected="True" />
                        <ComboBoxItem Content="230 km — full range" Tag="230000" />
                    </ComboBox>

                    <Button x:Name="VolumeResetButton" Content="Reset the view" Padding="0,5"
                            AutomationProperties.Name="Reset the 3D view"
                            Click="VolumeReset_Click" />

                    <TextBlock x:Name="VolumeSummary" FontSize="10" TextWrapping="Wrap"
                               Margin="0,10,0,0" Foreground="{StaticResource TextDim}" Text="" />
                </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="DrawingPanel" DockPanel.Dock="Right" Width="212"
                    Visibility="Collapsed" Background="{StaticResource Chrome}"
                    BorderBrush="#FF272C35" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,6,6,6">
                    <TextBlock Text="DRAW" FontWeight="Bold" FontSize="11"
                               Foreground="{StaticResource TextDim}" Margin="0,0,0,6" />

                    <TextBlock Text="Shape" FontSize="10.5" Foreground="{StaticResource TextDim}" />
                    <ComboBox x:Name="DrawKindCombo" Margin="0,3,0,8"
                              AutomationProperties.Name="Shape to draw"
                              SelectionChanged="DrawKind_Changed">
                        <ComboBoxItem Content="Line" Tag="Line" IsSelected="True" />
                        <ComboBoxItem Content="Area (filled)" Tag="Polygon" />
                        <ComboBoxItem Content="Circle" Tag="Circle" />
                        <ComboBoxItem Content="Label" Tag="Text" />
                    </ComboBox>

                    <TextBlock x:Name="DrawTextLabel" Text="Label text" FontSize="10.5"
                               Visibility="Collapsed" Foreground="{StaticResource TextDim}" />
                    <TextBox x:Name="DrawTextBox" Margin="0,3,0,8" Visibility="Collapsed"
                             AutomationProperties.Name="Label text"
                             TextChanged="DrawText_Changed" />

                    <TextBlock Text="Colour" FontSize="10.5" Foreground="{StaticResource TextDim}" />
                    <ComboBox x:Name="DrawColorCombo" Margin="0,3,0,8"
                              AutomationProperties.Name="Drawing colour"
                              SelectionChanged="DrawColor_Changed">
                        <ComboBoxItem Content="Amber" Tag="255,200,40" IsSelected="True" />
                        <ComboBoxItem Content="White" Tag="255,255,255" />
                        <ComboBoxItem Content="Red" Tag="255,70,70" />
                        <ComboBoxItem Content="Cyan" Tag="80,220,255" />
                        <ComboBoxItem Content="Lime" Tag="120,255,120" />
                        <ComboBoxItem Content="Magenta" Tag="255,110,220" />
                    </ComboBox>

                    <TextBlock Text="Thickness" FontSize="10.5" Foreground="{StaticResource TextDim}" />
                    <Slider x:Name="DrawWidthSlider" Minimum="1" Maximum="8" Value="2"
                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,3,0,8"
                            AutomationProperties.Name="Line thickness"
                            ValueChanged="DrawWidth_Changed" />

                    <TextBlock x:Name="DrawHint" FontSize="10.5" FontStyle="Italic"
                               TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{StaticResource TextDim}"
                               Text="Click to start. Each click adds a corner." />

                    <UniformGrid Columns="2" Margin="0,0,0,6">
                        <Button x:Name="DrawFinishButton" Content="Finish" Padding="0,5" Margin="0,0,3,0"
                                AutomationProperties.Name="Finish this shape" Click="DrawFinish_Click"
                                ToolTip="Close off the shape being drawn (Enter)" />
                        <Button x:Name="DrawUndoButton" Content="Undo" Padding="0,5" Margin="3,0,0,0"
                                AutomationProperties.Name="Undo the last shape" Click="DrawUndo_Click"
                                ToolTip="Take back the last point, or the last finished shape (Backspace)" />
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,0,0,6">
                        <Button x:Name="DrawOpenButton" Content="Open…" Padding="0,5" Margin="0,0,3,0"
                                AutomationProperties.Name="Open a drawing" Click="DrawOpen_Click"
                                ToolTip="Add the shapes from a placefile to this drawing" />
                        <Button x:Name="DrawSaveButton" Content="Save…" Padding="0,5" Margin="3,0,0,0"
                                AutomationProperties.Name="Save this drawing" Click="DrawSave_Click"
                                ToolTip="Save as a placefile — it opens in GR as well as here" />
                    </UniformGrid>
                    <Button x:Name="DrawClearButton" Content="Clear all" Padding="0,5"
                            AutomationProperties.Name="Clear the whole drawing" Click="DrawClear_Click" />

                    <TextBlock FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{StaticResource TextDim}"
                               Text="Saved as an ordinary GRLevelX placefile, so a drawing opens in GR too — and any placefile can be opened here to trace over." />
                </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="WindProfilePanel" DockPanel.Dock="Right" Width="196"
                    Visibility="Collapsed" Background="{StaticResource Chrome}"
                    BorderBrush="#FF272C35" BorderThickness="1,0,0,0">
                <DockPanel Margin="8,6,6,6">
                    <TextBlock DockPanel.Dock="Top" Text="WIND PROFILE" FontWeight="Bold" FontSize="11"
                               Foreground="{StaticResource TextDim}" Margin="0,0,0,2" />
                    <TextBlock x:Name="WindProfileNote" DockPanel.Dock="Top" FontSize="10.5"
                               FontStyle="Italic" TextWrapping="Wrap" Margin="0,0,0,6"
                               Foreground="{StaticResource TextDim}" Text="" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="WindProfileList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="30">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Height}" FontFamily="Consolas" FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextDim}" />
                                        <Path Grid.Column="1" Data="{Binding Barb}" Stroke="{StaticResource Text}"
                                              Fill="{StaticResource Text}" StrokeThickness="1.4"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stretch="None" />
                                        <TextBlock Grid.Column="2" Text="{Binding Wind}" FontFamily="Consolas"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Text}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid x:Name="PaneGrid">
                <Border x:Name="MapHost" />
                <!-- Empty state. A Border in the same Grid as the D3D host would be covered by
                     it (airspace), so it is only ever shown while no map surface exists yet. -->
                <Border x:Name="EmptyState" Visibility="Collapsed" Background="{StaticResource Chrome}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                        <TextBlock Text="No radar data loaded" FontSize="17" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                                   Foreground="{StaticResource TextDim}"
                                   Text="Pick a radar site, search for a place, or press 🎯 to jump to the heaviest weather in the country." />
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
