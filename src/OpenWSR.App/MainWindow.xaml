<Window x:Class="OpenWSR.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenWSR" Width="1280" Height="800" Background="#1A1C21">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top" Background="#22252B">
            <ToolBar Background="#22252B" Foreground="#C8CCD4" Loaded="ToolBar_Loaded">
                <ComboBox x:Name="SiteCombo" Width="220" Margin="4,0" />
                <Button x:Name="NearestButton" Content="Nearest" Margin="4,0" Click="NearestButton_Click"
                        ToolTip="Select the WSR-88D closest to the map center" />
                <Separator />
                <DatePicker x:Name="DayPicker" Margin="4,0" />
                <Button x:Name="LoadDayButton" Content="Load day" Margin="4,0" Click="LoadDayButton_Click" />
                <Separator />
                <Button x:Name="PlayButton" Content="▶ Loop" Margin="4,0" Click="PlayButton_Click"
                        ToolTip="Loop the most recent 30 volumes of the loaded day" />
                <ComboBox x:Name="SpeedCombo" Width="70" Margin="4,0" SelectionChanged="SpeedCombo_SelectionChanged">
                    <ComboBoxItem Content="2 fps" />
                    <ComboBoxItem Content="4 fps" IsSelected="True" />
                    <ComboBoxItem Content="8 fps" />
                </ComboBox>
                <Separator />
                <ToggleButton x:Name="LiveToggle" Content="⦿ Live" Margin="4,0"
                              Checked="LiveToggle_Checked" Unchecked="LiveToggle_Unchecked"
                              ToolTip="Stream real-time chunks for the selected site" />
                <ToggleButton x:Name="StormsToggle" Content="⛈ Storms" Margin="4,0"
                              Checked="StormsToggle_Checked" Unchecked="StormsToggle_Unchecked"
                              ToolTip="Overlay Level III storm tracks, hail, and mesocyclones for the selected site" />
                <Separator />
                <Button x:Name="PaletteButton" Content="Palette…" Margin="4,0" Click="PaletteButton_Click"
                        ToolTip="Import a GR2Analyst .pal color table for the current product" />
                <Separator />
                <ComboBox x:Name="PaneCombo" Width="80" Margin="4,0" SelectionChanged="PaneCombo_SelectionChanged"
                          ToolTip="Number of map panes">
                    <ComboBoxItem Content="1 pane" IsSelected="True" />
                    <ComboBoxItem Content="2 panes" />
                    <ComboBoxItem Content="4 panes" />
                </ComboBox>
                <ToggleButton x:Name="LinkToggle" Content="⛓ Linked" Margin="4,0" IsChecked="True"
                              Checked="LinkToggle_Changed" Unchecked="LinkToggle_Changed"
                              ToolTip="Link pan/zoom across panes" />
                <Separator />
                <Button x:Name="AboutButton" Content="About" Margin="4,0" Click="AboutButton_Click" />
            </ToolBar>
        </ToolBarTray>
        <StatusBar DockPanel.Dock="Bottom" Background="#22252B" Foreground="#C8CCD4">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="OpenWSR" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="FpsText" Text="" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="AgeText" Text="" FontWeight="Bold" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="InspectorText" Text="" FontFamily="Consolas" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="AttributionText" Text="© OpenStreetMap contributors" />
            </StatusBarItem>
        </StatusBar>
        <Grid DockPanel.Dock="Bottom" Background="#22252B">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="TimeSlider" Margin="8,4" Minimum="0" Maximum="0" IsEnabled="False"
                    IsSnapToTickEnabled="True" TickFrequency="1"
                    ValueChanged="TimeSlider_ValueChanged" />
            <TextBlock x:Name="TimeSliderLabel" Grid.Column="1" Margin="8,4" MinWidth="150"
                       Foreground="#C8CCD4" VerticalAlignment="Center" Text="—" />
        </Grid>
        <Border DockPanel.Dock="Right" Background="#22252B" Width="212">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10" TextElement.Foreground="#C8CCD4">
                    <TextBlock Text="LAYERS" FontWeight="Bold" Foreground="#8B93A3" Margin="0,0,0,6" />

                    <TextBlock Text="Radar opacity" Margin="0,4,0,0" />
                    <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="85"
                            ValueChanged="OpacitySlider_ValueChanged" />
                    <CheckBox x:Name="SmoothCheck" Content="Smooth radar" Margin="0,4,0,0"
                              ToolTip="Blend between radar cells for a softer, consumer-style display"
                              Checked="SmoothCheck_Changed" Unchecked="SmoothCheck_Changed" />

                    <TextBlock Text="Warnings" FontWeight="Bold" Margin="0,10,0,2" />
                    <CheckBox x:Name="FilterTornado" Content="Tornado" IsChecked="True" Foreground="#FF6B6B"
                              Checked="WarningFilter_Changed" Unchecked="WarningFilter_Changed" />
                    <CheckBox x:Name="FilterSevere" Content="Severe thunderstorm" IsChecked="True" Foreground="#FFE066"
                              Checked="WarningFilter_Changed" Unchecked="WarningFilter_Changed" />
                    <CheckBox x:Name="FilterFlood" Content="Flash flood" IsChecked="True" Foreground="#7BE07B"
                              Checked="WarningFilter_Changed" Unchecked="WarningFilter_Changed" />
                    <CheckBox x:Name="FilterOtherWarn" Content="Other warnings" IsChecked="True"
                              Checked="WarningFilter_Changed" Unchecked="WarningFilter_Changed" />

                    <TextBlock Text="Storm tracking" FontWeight="Bold" Margin="0,10,0,2" />
                    <CheckBox x:Name="FilterPastTrack" Content="Past track" IsChecked="True"
                              Checked="StormFilter_Changed" Unchecked="StormFilter_Changed" />
                    <CheckBox x:Name="FilterForecastTrack" Content="Forecast track" IsChecked="True"
                              Checked="StormFilter_Changed" Unchecked="StormFilter_Changed" />
                    <CheckBox x:Name="FilterCones" Content="Projection cones" IsChecked="True"
                              ToolTip="Direction + swept area over the next hour"
                              Checked="StormFilter_Changed" Unchecked="StormFilter_Changed" />
                    <CheckBox x:Name="FilterLabels" Content="Cell ID + max dBZ" IsChecked="True"
                              Checked="StormFilter_Changed" Unchecked="StormFilter_Changed" />
                    <CheckBox x:Name="FilterHail" Content="Hail markers" IsChecked="True"
                              Checked="StormFilter_Changed" Unchecked="StormFilter_Changed" />
                    <CheckBox x:Name="FilterMeso" Content="Mesocyclones" IsChecked="True" Foreground="#FFE066"
                              Checked="StormFilter_Changed" Unchecked="StormFilter_Changed" />
                    <TextBlock Text="Min severe-hail prob." Margin="0,6,0,0" />
                    <Slider x:Name="PoshSlider" Minimum="0" Maximum="100" Value="0" TickFrequency="10"
                            IsSnapToTickEnabled="True" ValueChanged="StormFilter_SliderChanged" />
                    <TextBlock FontStyle="Italic" Foreground="#8B93A3" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="Click a storm marker for cell details." />

                    <TextBlock Text="MY AREA" FontWeight="Bold" Foreground="#8B93A3" Margin="0,14,0,4" />
                    <Button x:Name="SetHomeButton" Content="📍 Set home on map" Click="SetHomeButton_Click" />
                    <TextBlock x:Name="HomeLabel" Text="Home: not set" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="Alert radius" Margin="0,6,0,0" />
                    <ComboBox x:Name="RadiusCombo" SelectionChanged="RadiusCombo_SelectionChanged">
                        <ComboBoxItem Content="15 km" />
                        <ComboBoxItem Content="40 km" IsSelected="True" />
                        <ComboBoxItem Content="80 km" />
                        <ComboBoxItem Content="160 km" />
                    </ComboBox>
                    <TextBlock x:Name="AlertArmedLabel" FontStyle="Italic" Foreground="#8B93A3"
                               TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Set a home location to arm proximity alerts." />
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Grid x:Name="PaneGrid">
            <Border x:Name="MapHost" />
        </Grid>
    </DockPanel>
</Window>
